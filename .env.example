# Copy to .env (server only). Environment variables override the file.
# codex_cli retains the frozen CLI model, effort, timeout and product login.
AIC_AI_PROVIDER=codex_cli
# Only used for provider=api; OpenAI-compatible /chat/completions contract.
AIC_AI_BASE_URL=
AIC_AI_MODEL=
AIC_AI_API_KEY=
AIC_AI_TIMEOUT_SECONDS=60
AIC_AI_GENERATION_PARAMS={}
# Offline: AIC_AI_PROVIDER=disabled; choose fixed-rule S0 in the page.
